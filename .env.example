# Copy to .env and edit. .env is gitignored; this file is not.
#
# Two audiences. If you only want to RUN the two databases and query them,
# everything you need is in section 1 and most of it is already the default.
# Section 2 is for rebuilding the knowledge base from source, which needs a
# SQL Server, a writable Neo4j, and Airflow.

# =====================================================================
# 1. SERVING  -- docker compose up -d qdrant neo4j
# =====================================================================

# Where the fine-tuned encoder lives. Queries are embedded with it, so it must
# be the same model the collections were built with -- a mismatch does not
# error, it just retrieves badly.
BIOBERT_MODEL_PATH="EmbeddingModel/biobert-go-retrieval"

# Qdrant, as published by docker-compose.yml.
QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY=""        # only if you set QDRANT__SERVICE__API_KEY in compose

# The Neo4j container. Leave unset unless you change the ports below.
# NEO4J_CONTAINER_URI="bolt://localhost:7687"

# Host ports. The defaults are the standard ones and are correct on a machine
# that is not already running Neo4j or Qdrant. Override only on collision --
# e.g. a Neo4j Desktop install already owns 7474/7687, in which case pick free
# ports here AND set NEO4J_CONTAINER_URI to match.
# NEO4J_HTTP_PORT="7474"
# NEO4J_BOLT_PORT="7687"
# QDRANT_REST_PORT="6333"
# QDRANT_GRPC_PORT="6334"

# Empty means the container runs with NEO4J_AUTH: none, which is the shipped
# default and is only safe because compose binds it to 127.0.0.1. If you set
# NEO4J_AUTH in compose, put the same password here -- and note it is honoured
# only on the container's FIRST start, while its volume is still empty.
# NEO4J_CONTAINER_PASSWORD=""

# =====================================================================
# 2. ETL  -- only needed to REBUILD the knowledge base
# =====================================================================

# Which pathway source the SQL schema is built for. Must agree with
# gene_database: pointing Reactome code at a KEGG database fails at upsert.
pathway_source="reactome"

# SQL Server holding the staging/diff/dbo schemas.
# sql_server="host,1433"
# gene_database="ReactomeGeneDataBase"
# sql_uid=""
# sql_pwd=""

# The Neo4j the ETL WRITES to. Distinct from NEO4J_CONTAINER_URI above, which
# is the read-only replica -- two servers, two sets of credentials, and
# nothing requires them to agree.
# NEO4J_URI="bolt://localhost:7687"
# NEO4J_USERNAME="neo4j"
# NEO4J_PASSWORD=""

# Run id stamped onto diff rows. Must be a GUID: it lands in a
# UNIQUEIDENTIFIER column and a plain string fails the whole upsert.
# uuid=""

# Only for neo4j_snapshot, and only when the source is Neo4j Desktop: the
# DBMS's data dir. Desktop keeps every instance you have ever made under a
# UUID, so find the live one rather than guessing --
#   CALL dbms.listConfig('server.directories.data')
# against the running server gives it exactly.
# NEO4J_DESKTOP_DATA=""

# Publishing the training dataset as a release asset.
# GITHUB_TOKEN=""
# GITHUB_DATASET_REPO="yoyo4581/POKnowledgeBase_ETL"
